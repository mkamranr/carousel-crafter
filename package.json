{
  "name": "carousel-crafter",
  "version": "0.1.0",
  "type": "module",
  "description": "Markdown → Instagram carousel PNGs, rendered through a React template in headless Chromium",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "carousel-crafter": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "build:web": "vite build",
    "dev:web": "vite",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "web": "node dist/cli.js web"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@shikijs/rehype": "^4.4.3",
    "commander": "^15.0.0",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "mdast-util-to-hast": "^13.2.1",
    "playwright": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "author": "mkamranr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkamranr/carousel-crafter.git"
  },
  "private": "true"
}

# Copy to .env and fill in what you need. Every one of these is optional, and every one
# overrides the equivalent value in carousel.config.json — so a key can be supplied without
# ever being written into your posts folder.
#
# .env is gitignored. Do not commit it.

# Drafting. Any OpenAI-compatible endpoint: Ollama, vLLM, OpenRouter, OpenAI.
# Not needed for a local model that takes no key.
OPENAI_API_KEY=

# Stock photo backgrounds. Free key from https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional. Raises GitHub's 60-requests-an-hour limit when drafting from repository links.
GITHUB_TOKEN=
